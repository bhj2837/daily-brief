# ===== Daily Brief 환경 변수 =====
# 모든 키는 선택 사항입니다. 키가 없어도 전체 기능이 실시간(무키 API) 또는 샘플로 동작합니다.

# 날씨 (선택) — OpenWeather 키를 넣으면 우선 사용, 없으면 Open-Meteo(무키)로 실시간 동작
# https://openweathermap.org/api → My API Keys
VITE_OPENWEATHER_API_KEY=

# 증시 (선택) — Finnhub 키를 넣으면 실데이터, 없으면 샘플. https://finnhub.io
VITE_FINNHUB_API_KEY=

# 한국 종합뉴스 (선택) — GNews / NewsData / Guardian 중 택1, 없으면 샘플
VITE_GNEWS_API_KEY=
